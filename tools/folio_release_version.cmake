# Monotonic online-update sequence; mirror tools/release_manifest.py.
# The value is derived from the actual app descriptor version, never hand set.
function(folio_release_sequence version output)
    if(NOT "${version}" MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)(-(dev|rc)(\\.([0-9]+))?)?$")
        message(FATAL_ERROR "Unsupported Folio release version: ${version}")
    endif()
    set(major "${CMAKE_MATCH_1}")
    set(minor "${CMAKE_MATCH_2}")
    set(patch "${CMAKE_MATCH_3}")
    set(kind "${CMAKE_MATCH_5}")
    set(number "${CMAKE_MATCH_7}")
    foreach(part IN ITEMS major minor patch)
        if("${${part}}" MATCHES "^0[0-9]+$")
            message(FATAL_ERROR "Leading zero in Folio release version: ${version}")
        endif()
    endforeach()
    if(major GREATER 42 OR minor GREATER 99 OR patch GREATER 999)
        message(FATAL_ERROR "Folio release version is outside sequence range")
    endif()
    if(kind STREQUAL "dev")
        set(stage 0)
        if(NOT number STREQUAL "")
            if(number LESS 1 OR number GREATER 499 OR "${number}" MATCHES "^0")
                message(FATAL_ERROR "dev.N requires N=1..499 without leading zeros")
            endif()
            set(stage "${number}")
        endif()
    elseif(kind STREQUAL "rc")
        if(number STREQUAL "" OR number LESS 1 OR number GREATER 498 OR "${number}" MATCHES "^0")
            message(FATAL_ERROR "rc.N requires N=1..498 without leading zeros")
        endif()
        math(EXPR stage "500 + ${number}")
    else()
        set(stage 999)
    endif()
    math(EXPR sequence "${major} * 100000000 + ${minor} * 1000000 + ${patch} * 1000 + ${stage}")
    if(sequence GREATER 4294967295)
        message(FATAL_ERROR "Folio release sequence exceeds uint32")
    endif()
    set(${output} "${sequence}" PARENT_SCOPE)
endfunction()
